<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Calculo_ductos_winUi_3.Views.ShowTotalPrice"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Calculo_ductos_winUi_3.Views"
    xmlns:models="using:Calculo_ductos_winUi_3.Models"
    xmlns:converters="using:Calculo_ductos_winUi_3.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
    </Page.Resources>

    <Grid Margin="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Título -->
        <TextBlock
            Grid.Row="0" Grid.ColumnSpan="3"
            Text="Costo del proyecto"
            Style="{StaticResource TitleTextBlockStyle}"
            Padding="36,40,0,0"/>

        <!-- Tipo de cambio -->
        <Border
            Grid.Row="1" Grid.Column="0"
            CornerRadius="15"
            Margin="32,16,16,16"
            VerticalAlignment="Top"
            Background="{StaticResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Padding="16">
                <TextBlock Text="Tipo de cambio"
                           Foreground="{StaticResource TextFillColorPrimaryBrush}"
                           FontWeight="Bold" FontSize="17"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Bind stateApp.CompleteDuctVm.ExchangeRateFormatted, Mode=OneWay}"
                           Foreground="{StaticResource TextFillColorPrimaryBrush}"
                           FontWeight="Bold" FontSize="17"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tarjetas de precios (columna central) -->
        <ScrollViewer Grid.Row="1" Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,8,16,16" Spacing="8">

                <!-- Despiece -->
                <Border CornerRadius="15" Background="{StaticResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <Border Width="12" HorizontalAlignment="Left" CornerRadius="15,0,0,15">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#2196F3" Offset="0"/>
                                    <GradientStop Color="#1976D2" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Grid Margin="24,16,24,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Despiece"
                                       FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,16,0"
                                       Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                            <TextBox Grid.Column="1"
                                     Text="{x:Bind stateApp.TotalPriceConceptDuctFormatted, Mode=OneWay}"
                                     IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                     TextAlignment="Right" Padding="0" FontSize="18"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource TextFillColorPrimaryBrush}"
                                     UseSystemFocusVisuals="False" FocusVisualPrimaryThickness="0"
                                     FocusVisualSecondaryThickness="0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Mano de obra -->
                <Border CornerRadius="15" Background="{StaticResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <Border Width="12" HorizontalAlignment="Left" CornerRadius="15,0,0,15">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFBCAAA4" Offset="0"/>
                                    <GradientStop Color="#FF8D6E63" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Grid Margin="24,16,24,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mano de obra"
                                       FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,16,0"
                                       Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                            <TextBox Grid.Column="1"
                                     Text="{x:Bind stateApp.TotalPriceConceptMOFormatted, Mode=OneWay}"
                                     IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                     TextAlignment="Right" Padding="0" FontSize="18"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource TextFillColorPrimaryBrush}"
                                     UseSystemFocusVisuals="False" FocusVisualPrimaryThickness="0"
                                     FocusVisualSecondaryThickness="0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Indirectos -->
                <Border CornerRadius="15" Background="{StaticResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <Border Width="12" HorizontalAlignment="Left" CornerRadius="15,0,0,15">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#9981C784" Offset="0"/>
                                    <GradientStop Color="#CC388E3C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Grid Margin="24,16,24,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Indirectos"
                                       FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,16,0"
                                       Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                            <TextBox Grid.Column="1"
                                     Text="{x:Bind stateApp.TotalPriceConceptIndirectFormatted, Mode=OneWay}"
                                     IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                     TextAlignment="Right" Padding="0" FontSize="18"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource TextFillColorPrimaryBrush}"
                                     UseSystemFocusVisuals="False" FocusVisualPrimaryThickness="0"
                                     FocusVisualSecondaryThickness="0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Flete -->
                <Border CornerRadius="15" Background="{StaticResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <Border Width="12" HorizontalAlignment="Left" CornerRadius="15,0,0,15">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#997E57C2" Offset="0"/>
                                    <GradientStop Color="#CC512DA8" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Grid Margin="24,16,24,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Flete"
                                       FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,16,0"
                                       Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                            <TextBox Grid.Column="1"
                                     Text="{x:Bind stateApp.FreightVM.TotalPriceFormatted, Mode=OneWay}"
                                     IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                     TextAlignment="Right" Padding="0" FontSize="18"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource TextFillColorPrimaryBrush}"
                                     UseSystemFocusVisuals="False" FocusVisualPrimaryThickness="0"
                                     FocusVisualSecondaryThickness="0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Total del proyecto -->
                <Border CornerRadius="15" Background="{StaticResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <Border Width="12" HorizontalAlignment="Left" CornerRadius="15,0,0,15">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#99FFD54F" Offset="0"/>
                                    <GradientStop Color="#CCFFC107" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Margin="24,20,24,20" HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="Total del proyecto"
                                       TextAlignment="Center" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                            <TextBox Text="{x:Bind stateApp.TotalConceptsPriceFormatted, Mode=OneWay}"
                                     Background="Transparent" Foreground="{StaticResource TextFillColorPrimaryBrush}"
                                     FontWeight="Bold" FontSize="28" BorderThickness="0"
                                     IsReadOnly="True" TextAlignment="Center"
                                     UseSystemFocusVisuals="False" FocusVisualPrimaryThickness="0"
                                     FocusVisualSecondaryThickness="0"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Lista de conceptos (columna derecha) -->
        <Border x:Name="ConceptsList"
                Grid.Row="1" Grid.Column="2"
                CornerRadius="15"
                Margin="16,8,32,16"
                Background="{StaticResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="Este proyecto incluye los siguientes conceptos"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextFillColorSecondaryBrush}"
                           Margin="16,16,16,8"
                           TextWrapping="Wrap"/>
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind stateApp.Concepts, Mode=OneWay}"
                          SelectionMode="None"
                          Margin="4,0,4,8">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="4,2"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ConceptModel">
                            <Grid Padding="4,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Checkbox: invisible pero reserva espacio cuando no es editable -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                          IsHitTestVisible="{x:Bind IsEditable}"
                                          Opacity="{x:Bind IsEditable, Converter={StaticResource BoolToOpacityConverter}}"
                                          VerticalAlignment="Center"
                                          Padding="0" MinWidth="0"/>

                                <!-- Descripción y precio -->
                                <StackPanel Grid.Column="1" Margin="4,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Description}"
                                               FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind TotalPriceFormatted, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                                <!-- Botones +/-: invisibles pero reservan espacio cuando no es editable -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            VerticalAlignment="Center" Spacing="4"
                                            IsHitTestVisible="{x:Bind IsEditable}"
                                            Opacity="{x:Bind IsEditable, Converter={StaticResource BoolToOpacityConverter}}">
                                    <Button Content="-" Width="28" Height="28" Padding="0"
                                            Command="{x:Bind DecrementCommand}"/>
                                    <TextBlock Text="{x:Bind Count, Mode=OneWay}"
                                               VerticalAlignment="Center"
                                               MinWidth="20" TextAlignment="Center" FontSize="13"/>
                                    <Button Content="+" Width="28" Height="28" Padding="0"
                                            Command="{x:Bind IncrementCommand}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

    </Grid>
</Page>
