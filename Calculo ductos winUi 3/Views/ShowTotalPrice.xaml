<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Calculo_ductos_winUi_3.Views.ShowTotalPrice"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Calculo_ductos_winUi_3.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"></ColumnDefinition>
            <ColumnDefinition Width="3*"></ColumnDefinition>
            <ColumnDefinition Width="3*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid x:Name="TopGrid"
            Grid.ColumnSpan="3"
            Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                Text="Costo del proyecto" 
                Style="{StaticResource TitleTextBlockStyle}"
                Padding="36,40,0,0"
                />
        </Grid>
        <Grid x:Name="ExchangeRate"
              CornerRadius="15"
              Grid.Row="1"
              Grid.Column="0"
              Margin="32,32,16,0"
              Visibility="Collapsed"
              Background="{StaticResource CardBackgroundFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock Text="Tipo de cambio" 
               Foreground="{StaticResource TextFillColorPrimaryBrush}"
               FontWeight="Bold"
               FontSize="17"
               Margin="0,16,0,0"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Bind stateApp.CompleteDuctVm.ExchangeRateFormatted, Mode=OneWay}" 
                Foreground="{StaticResource TextFillColorPrimaryBrush}"
                FontWeight="Bold"
                FontSize="17"
                Margin="0,0,0,16"
                Grid.Row="1"
                TextAlignment="Center"
                VerticalAlignment="Center"/>
        </Grid>
        
        <Grid x:Name="DuctGrid"
              Grid.Row="2"
              Grid.Column="1"
              Grid.ColumnSpan="1"
                Margin="0,0,0,0">

            <Border
                CornerRadius="15"
                Background="{StaticResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <!-- Barra lateral -->

                    <Border Width="12"
                    HorizontalAlignment="Left"
                    CornerRadius="15,0,0,15">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="0,1">
                                <GradientStop Color="#2196F3"
                                      Offset="0"/>
                                <GradientStop Color="#1976D2"
                                      Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                    </Border>
                    
                    <!-- Contenido -->
                    
                    <StackPanel 
                        Margin="24,20,24,20"
                        CornerRadius="15,0,0,15"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="10">

                        <TextBlock Text="Despiece"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextFillColorSecondaryBrush}" />

                        <TextBox Text="{x:Bind stateApp.CompleteDuctVm.SubTotalPriceFormatted, Mode=OneWay}"
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         TextAlignment="Center"
                         Padding="0"
                         FontSize="20"
                         Foreground="{StaticResource TextFillColorPrimaryBrush}"
                         UseSystemFocusVisuals="False"
                         FocusVisualPrimaryThickness="0"
                         FocusVisualSecondaryThickness="0"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>
        <Grid x:Name="FreightGrid"
       Grid.Row="3"
       Grid.Column="1"
       Grid.ColumnSpan="1"
         Margin="0,0,0,0">

            <Border
         CornerRadius="15"
         Background="{StaticResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <!-- Barra lateral -->

                    <Border Width="12"
             HorizontalAlignment="Left"
             CornerRadius="15,0,0,15">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                  EndPoint="0,1">
                                <GradientStop Color="#997E57C2"
                               Offset="0"/>
                                <GradientStop Color="#CC512DA8"
                               Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                    </Border>

                    <!-- Contenido -->

                    <StackPanel 
                 Margin="24,20,24,20"
                 CornerRadius="15,0,0,15"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                 Spacing="10">

                        <TextBlock Text="Flete"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextFillColorSecondaryBrush}" />

                        <TextBox Text="{x:Bind stateApp.FreightVM.TotalPriceFormatted, Mode=OneWay}"
                            IsReadOnly="True"
                            Background="Transparent"
                            BorderThickness="0"
                            TextAlignment="Center"
                            Padding="0"
                            FontSize="20"
                            Foreground="{StaticResource TextFillColorPrimaryBrush}"
                            UseSystemFocusVisuals="False"
                            FocusVisualPrimaryThickness="0"
                            FocusVisualSecondaryThickness="0"/>         
                        <TextBox Text="{x:Bind stateApp.FreightVM.SubTotalPriceFormatted, Mode=OneWay}" 
                    Background="Transparent" 
                    Foreground="{StaticResource TextFillColorPrimaryBrush}"
                    FontSize="15"
                    BorderThickness="0"
                    Grid.Row="2"
                    IsReadOnly="True"
                    Visibility="Collapsed"
                    TextAlignment="Center"
                    VerticalAlignment="Top"
                    UseSystemFocusVisuals="False"
                    FocusVisualPrimaryThickness="0"
                    FocusVisualSecondaryThickness="0"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>
        <Grid x:Name="ManPowerGridTotal"
    Grid.Row="4"
    Grid.Column="1"
    Grid.ColumnSpan="1"
  Margin="0,0,0,0">

            <Border
  CornerRadius="15"
  Background="{StaticResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <!-- Barra lateral -->

                    <Border Width="12"
      HorizontalAlignment="Left"
      CornerRadius="15,0,0,15">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0"
                           EndPoint="0,1">
                                <GradientStop Color="#FFBCAAA4"
                        Offset="0"/>
                                <GradientStop Color="#FF8D6E63"
                        Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                    </Border>

                    <!-- Contenido -->

                    <StackPanel 
          Margin="24,20,24,20"
          CornerRadius="15,0,0,15"
                 Orientation="Horizontal"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center"
          Spacing="10">

                        <TextBlock Text="Mano de obra "
             FontSize="16"
             FontWeight="SemiBold"
             Foreground="{StaticResource TextFillColorSecondaryBrush}" />

                        <TextBox Text="{x:Bind stateApp.ManPowerVM.TotalPriceFormatted, Mode=OneWay}" 
                            IsReadOnly="True"
                            Background="Transparent"
                            BorderThickness="0"
                            TextAlignment="Center"
                            Padding="0"
                            FontSize="20"
                            Foreground="{StaticResource TextFillColorPrimaryBrush}"
                            UseSystemFocusVisuals="False"
                            FocusVisualPrimaryThickness="0"
                            FocusVisualSecondaryThickness="0"/> 
                        <TextBox Text="{x:Bind stateApp.ManPowerVM.SubTotalPriceFormatted, Mode=OneWay}" 
                    Background="Transparent" 
                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                    Visibility="Collapsed"
                    FontSize="15"
                    BorderThickness="0"
                    Grid.Row="2"
                    IsReadOnly="True"
                    TextAlignment="Center"
                    VerticalAlignment="Top"
                    UseSystemFocusVisuals="False"
                    Padding="0,0,0,8"
                    FocusVisualPrimaryThickness="0"
                    FocusVisualSecondaryThickness="0"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>
