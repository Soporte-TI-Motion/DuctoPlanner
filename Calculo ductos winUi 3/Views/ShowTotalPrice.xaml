             UseSystemFocusVisuals="False"
             FocusVisualPrimaryThickness="0"
             FocusVisualSecondaryThickness="0"/>

        </Grid>
        <Grid x:Name="IndirectsGridWC"
            CornerRadius="15"
            Grid.Row="3"       
            Grid.Column="3"
            Margin="16,16,16,0"
            Visibility="Collapsed"
            Background="{StaticResource CardBackgroundFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Border 
                Grid.Row="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#9981C784" Offset="0.0"/>
                        <GradientStop Color="#CC388E3C" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="Indirectos (Sanitarios)" 
                    Foreground="{StaticResource TextFillColorInverseBrush}"
                    FontWeight="Bold"
                    FontSize="17"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"/>
            </Border>
            <TextBox Text="{x:Bind stateApp.IndirectsVM.TotalPriceWCFormatted, Mode=OneWay}" 
             Background="Transparent" 
             Foreground="{StaticResource TextFillColorPrimaryBrush}"
             FontWeight="Bold"
             FontSize="17"
             BorderThickness="0"
             Grid.Row="1"
             IsReadOnly="True"
             TextAlignment="Center"
             VerticalAlignment="Bottom"
             UseSystemFocusVisuals="False"
             FocusVisualPrimaryThickness="0"
             FocusVisualSecondaryThickness="0"/>
            <TextBox Text="{x:Bind stateApp.IndirectsVM.SubTotalPriceWCFormatted, Mode=OneWay}" 
             Background="Transparent" 
             Foreground="{StaticResource TextFillColorPrimaryBrush}"
             Visibility="Collapsed"
             FontSize="15"
             BorderThickness="0"
             Grid.Row="2"
             IsReadOnly="True"
             TextAlignment="Center"
             VerticalAlignment="Top"
             Padding="0,0,0,8"
             UseSystemFocusVisuals="False"
             FocusVisualPrimaryThickness="0"
             FocusVisualSecondaryThickness="0"/>

        </Grid>
        <Grid x:Name="IndirectsGridStore"
            CornerRadius="15"
            Grid.Row="4"
            Grid.Column="3"
            Margin="16,16,16,0"
            Visibility="Collapsed"
            Background="{StaticResource CardBackgroundFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Border 
                Grid.Row="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#9981C784" Offset="0.0"/>
                        <GradientStop Color="#CC388E3C" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="Indirectos (Bodega)" 
                Foreground="{StaticResource TextFillColorInverseBrush}"
                FontWeight="Bold"
                FontSize="17"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"/>
            </Border>
            <TextBox Text="{x:Bind stateApp.IndirectsVM.TotalPriceStoreFormatted, Mode=OneWay}" 
                 Background="Transparent" 
                 Foreground="{StaticResource TextFillColorPrimaryBrush}"
                 FontWeight="Bold"
                 FontSize="17"
                 BorderThickness="0"
                 Grid.Row="1"
                 IsReadOnly="True"
                 TextAlignment="Center"
                 VerticalAlignment="Bottom"
                 UseSystemFocusVisuals="False"
                 FocusVisualPrimaryThickness="0"
                 FocusVisualSecondaryThickness="0"/>
            <TextBox Text="{x:Bind stateApp.IndirectsVM.SubTotalPriceStoreFormatted, Mode=OneWay}" 
             Background="Transparent" 
             Foreground="{StaticResource TextFillColorPrimaryBrush}"
             Visibility="Collapsed"
             FontSize="15"
             BorderThickness="0"
             Grid.Row="2"
             IsReadOnly="True"
             TextAlignment="Center"
             VerticalAlignment="Top"
             Padding="0,0,0,8"
             UseSystemFocusVisuals="False"
             FocusVisualPrimaryThickness="0"
             FocusVisualSecondaryThickness="0"/>

        </Grid>

        <Grid x:Name="ProjectGrid"
          Grid.Row="6"
          Grid.RowSpan="2"
          Grid.Column="1"
          Grid.ColumnSpan="1"
          Margin="0,0,0,0">

            <Border
         CornerRadius="15"
         Background="{StaticResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <!-- Barra lateral -->

                    <Border Width="12"
                         HorizontalAlignment="Left"
                         CornerRadius="15,0,0,15">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                  EndPoint="0,1">
                                <GradientStop Color="#99FFD54F"
                               Offset="0"/>
                                <GradientStop Color="#CCFFC107"
                               Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                    </Border>

                    <!-- Contenido -->

                    <StackPanel 
                 Margin="24,20,24,20"
                 CornerRadius="15,0,0,15"
                        HorizontalAlignment="Center"
                 Spacing="10">

                        <TextBlock Text="Total del proyecto"
                                   TextAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextFillColorSecondaryBrush}" />

                        <TextBox Text="{x:Bind stateApp.TotalPriceFormatted, Mode=OneWay}" 
                    Background="Transparent" 
                    Foreground="{StaticResource TextFillColorPrimaryBrush}"
                    FontWeight="Bold"
                    FontSize="28"
                    BorderThickness="0"
                    Grid.Row="1"
                    IsReadOnly="True"
                    TextAlignment="Center"
                    VerticalAlignment="Bottom"
                    UseSystemFocusVisuals="False"
                    FocusVisualPrimaryThickness="0"
                    FocusVisualSecondaryThickness="0"/>
                        <TextBox Text="{x:Bind stateApp.SubTotalPriceFormatted, Mode=OneWay}" 
                    Background="Transparent" 
                    Foreground="{StaticResource TextFillColorPrimaryBrush}"
                    Visibility="Collapsed"
                    FontSize="17"
                    BorderThickness="0"
                    Grid.Row="2"
                    IsReadOnly="True"
                    TextAlignment="Center"
                    VerticalAlignment="Top"
                    UseSystemFocusVisuals="False"
                    FocusVisualPrimaryThickness="0"
                    FocusVisualSecondaryThickness="0"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>
    </Grid>
</Page>
